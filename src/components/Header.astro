---
import type { Locale } from '@/lib/i18n';
import { ui, collectionPath } from '@/lib/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
  translations?: Partial<Record<Locale, string>>;
}

const { locale, translations } = Astro.props;
const t = ui[locale];

const homeHref = locale === 'pt' ? '/' : '/en/';

const nav = [
  { href: homeHref, label: t.navHome },
  { href: collectionPath('articles', locale), label: t.navArticles },
  { href: collectionPath('demos', locale), label: t.navDemos },
  { href: collectionPath('tags', locale), label: t.navTags },
  { href: collectionPath('search', locale), label: t.navSearch },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/' || normalized === '/en') {
    return currentPath === normalized || currentPath === `${normalized}/`;
  }
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
};
---

<header
  class="border-b border-[color:var(--color-border)]"
  style="background-color: var(--color-surface);"
>
  <div class="container-wide flex flex-wrap items-center gap-4 py-4">
    <a
      href={homeHref}
      class="flex items-center no-underline"
      style="color: var(--color-text);"
      aria-label={t.siteName}
    >
      <img
        src="/images/brand/soucheff-logo.png"
        alt={t.siteName}
        width="120"
        height="80"
        class="h-20 w-auto rounded-md px-2 py-1"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav aria-label="primary" class="ml-auto hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm font-medium no-underline',
            isActive(item.href)
              ? 'text-[color:var(--color-primary)]'
              : 'text-[color:var(--color-text-muted)] hover:text-[color:var(--color-primary)]',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <LangSwitcher currentLocale={locale} translations={translations} fallbackHome={!translations} />
      <ThemeToggle locale={locale} />

      <details class="nav-details relative md:hidden">
        <summary
          class="flex list-none items-center justify-center rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-2 text-[color:var(--color-text)]"
          aria-label={t.navMenu}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <nav
          aria-label={t.navMenu}
          class="absolute right-0 top-full z-20 mt-2 flex w-48 flex-col gap-1 rounded-md border border-[color:var(--color-border)] p-2 shadow-lg"
          style="background-color: var(--color-surface);"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium no-underline',
                isActive(item.href)
                  ? 'text-[color:var(--color-primary)]'
                  : 'text-[color:var(--color-text-muted)] hover:text-[color:var(--color-primary)]',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-details > summary {
    cursor: pointer;
  }

  .nav-details > summary::-webkit-details-marker {
    display: none;
  }

  .nav-details[open] > summary {
    border-color: var(--color-primary);
  }
</style>
